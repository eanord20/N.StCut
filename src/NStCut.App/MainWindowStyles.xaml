<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:NStCut.App.Converters"
                    xmlns:loc="clr-namespace:NStCut.App.Services">
    <!--
        Стили, специфичные для MainWindow, вынесены сюда из Window.Resources, чтобы разгрузить
        основной XAML-файл (docs/Code_Audit_UI.md, "Important Improvements → Читаемость XAML";
        docs/Audit_Architecture.md, DRY Assessment D6).
    -->
    <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
    <conv:ActiveMaterialHighlightConverter x:Key="ActiveMaterialHighlightConverter" />

    <!-- Заголовок раздела (группы по материалу) в таблице деталей — кликабельный, делает материал "активным" для вставки.
         Name группы уже сконвертирован в отображаемое имя материала (см. MainViewModel: PropertyGroupDescription
         с MaterialIdToNameConverter) — поэтому здесь достаточно простого {Binding Name}, без MultiBinding.

         ВАЖНО: для DataGrid заголовок группы customized через GroupStyle.HeaderTemplate, а НЕ через
         GroupStyle.ContainerStyle с полной заменой ControlTemplate для GroupItem. У DataGrid заголовки
         групп рендерятся внутренним контролом DataGridRowGroupHeader, который синхронизирует свою
         разметку с шириной колонок через общий механизм измерения DataGrid. Полная замена шаблона
         GroupItem (как было раньше — Expander или свой Grid) убирает эту синхронизацию и ломает ширины
         колонок/заголовков во всей таблице. HeaderTemplate — штатный способ задать контент заголовка,
         не трогая структуру DataGridRowGroupHeader. -->
    <DataTemplate x:Key="SectionGroupHeaderTemplate">
        <Border Background="{DynamicResource MaterialDesignDivider}" Margin="0,4,0,0">
            <Button Content="{Binding Name}" Padding="4,2" Height="26" HorizontalContentAlignment="Left"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    Command="{Binding DataContext.SetActiveMaterialCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                    CommandParameter="{Binding Name}"
                    ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=TooltipActiveMaterial}" />
        </Border>
    </DataTemplate>

    <!-- Чип материала над таблицей: клик делает материал "активным" для вставки (работает и для ещё пустых разделов) -->
    <Style x:Key="MaterialChipStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Command" Value="{Binding DataContext.SetActiveMaterialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <Setter Property="CommandParameter" Value="{Binding Id}" />
        <Setter Property="Background">
            <Setter.Value>
                <MultiBinding Converter="{StaticResource ActiveMaterialHighlightConverter}">
                    <Binding Path="Id" />
                    <Binding Path="DataContext.ActivePasteMaterialId" RelativeSource="{RelativeSource AncestorType=Window}" />
                </MultiBinding>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
