<Window x:Class="NStCut.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NStCut.App.ViewModels"
        xmlns:conv="clr-namespace:NStCut.App.Converters"
        xmlns:controls="clr-namespace:NStCut.App.Controls"
        xmlns:loc="clr-namespace:NStCut.App.Services"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=WindowTitle}"
        Height="720" Width="1280" WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <!--
        Ширины столбцов таблицы деталей заданы фиксированными значениями (px), чтобы сумма
        колонок предсказуемо помещалась в ширину карточки без сжатия/расползания раскладки.
        Пользователь может менять ширину вручную (CanUserResizeColumns="True" на PartsGrid) —
        фактическая ширина каждой колонки сохраняется в app-settings.json при закрытии окна
        и восстанавливается при следующем запуске (см. MainWindow.xaml.cs: SaveColumnWidths/
        RestoreColumnWidths, MainViewModel.PartsGridColumnWidths). Значения ниже — это стартовые
        ширины "по умолчанию" (на первом запуске / для новых колонок).
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SectionGroupItemStyle/MaterialChipStyle/конвертеры вынесены сюда, чтобы разгрузить
                     этот файл (RF-025, docs/Code_Audit_UI.md; docs/Audit_Architecture.md, DRY D6).
                     PartRowStyle остаётся здесь — у него EventSetter'ы, обработчики которых должны
                     быть в code-behind именно этого файла (MainWindow.xaml.cs), поэтому вынести его
                     в отдельный ResourceDictionary без собственного x:Class нельзя. -->
                <ResourceDictionary Source="/MainWindowStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <x:Array x:Key="GrainModes" Type="{x:Type conv:GrainModeProxy}">
                <conv:GrainModeProxy Value="FollowMaterial" />
                <conv:GrainModeProxy Value="Allow90" />
                <conv:GrainModeProxy Value="Fixed0" />
            </x:Array>

            <!-- Строка таблицы деталей: DnD между разделами + подсветка по статусу + рамка при дубле номера -->
            <Style x:Key="PartRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                <Setter Property="AllowDrop" Value="True" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PartRow_PreviewMouseLeftButtonDown" />
                <EventSetter Event="MouseMove" Handler="PartRow_MouseMove" />
                <EventSetter Event="Drop" Handler="PartRow_Drop" />
                <Setter Property="Tag" Value="{Binding DataContext, ElementName=PartsGrid}" />
                <Setter Property="ContextMenu">
                    <Setter.Value>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ContextMenuFindFile}" Command="{Binding FindFilesCommand}" />
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ContextMenuSelectManually}" Command="{Binding SelectFileManuallyCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ContextMenuResolveAmbiguous}" Command="{Binding SelectAmbiguousFileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ContextMenuCopyDxfPath}" Command="{Binding CopyDxfPathCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ContextMenuDeleteRow}" Command="{Binding DeleteRowCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDuplicateNumber}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource DuplicateNumberBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Меню: "Розкрій ▾" содержит параметры раскроя (popup с двумя полями) вместо отдельной
             карточки в теле окна (docs/UX_Audit.md, раздел 5.1, v3). -->
        <Menu Grid.Row="0">
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuFile}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuOpenProject}" Command="{Binding OpenProjectCommand}" />
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuSaveProject}" Command="{Binding SaveProjectCommand}" />
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuNesting}">
                <MenuItem StaysOpenOnClick="True" IsHitTestVisible="True">
                    <MenuItem.Header>
                        <Grid Margin="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelSheetMargin}" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SheetMarginMm, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="?" Cursor="Help" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=HintSheetMargin}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,2,6,0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelPartGap}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Text="{Binding PartGapMm, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="?" Cursor="Help" FontWeight="Bold" VerticalAlignment="Center" Margin="6,2,0,0" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=HintPartGap}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </MenuItem.Header>
                </MenuItem>
                <Separator />
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuExportCombinedDxf}"
                          IsCheckable="True"
                          IsChecked="{Binding ExportCombinedDxf, Mode=TwoWay}"
                          StaysOpenOnClick="True" />
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuLanguage}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuEnglish}" Command="{Binding SetLanguageCommand}" CommandParameter="en" />
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuUkrainian}" Command="{Binding SetLanguageCommand}" CommandParameter="ua" />
            </MenuItem>
            <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuTheme}">
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuThemeLight}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuThemeDark}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
            </MenuItem>
        </Menu>

        <!-- Верхній блок — 2 колонки: зліва тулбар (3 рядки-групи, фіксована ширина), справа — шляхи
             пошуку/збереження + стан пошуку файлів (3 рядки, гнучка ширина). Порядок команд у тулбарі
             відповідає алгоритму роботи, без дублювання дій в інших місцях вікна
             (docs/UX_Audit.md, розділ 5.1, v3). -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Тулбар: Row 1 — наповнення таблиці, Row 2 — формування файлів, Row 3 — останні дії. -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Row 1 — наповнення таблиці: Матеріали → Вставити ▾ → Знайти файли -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding OpenMaterialsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Layers" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonMaterials}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- Вставити: основная команда по клику, импорт Excel доступен из контекстного меню;
                         обе команды занимают одну фиксированную ячейку 3x3. -->
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding PasteFromClipboardCommand}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonImportExcel}" Command="{Binding ImportExcelFileCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentPaste" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonPaste}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding FindFilesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileFind" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonFindFiles}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Row 2 — формування файлів: Розкрій → Export DXF → Export звіту -->
                    <Button Grid.Row="2" Grid.Column="0" Command="{Binding NestCommand}" Style="{StaticResource AppToolbarButtonStyle}" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonNest}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding ExportDxfCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExport" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonExportDxf}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding ExportReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonExportReport}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Row 3 — останні дії: Відкрити DXF → Відкрити звіт.
                         "Очистити" з макету docs/UX_Audit.md сюди НЕ включена — це нова функція
                         (ClearAllCommand відсутній у MainViewModel), позначена в аудиті як "поза
                         поточним обсягом, потребує окремого рішення". -->
                    <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding OpenOutputFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOpenDxfFolder}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding OpenReportCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileEyeOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOpenReport}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Row="4" Grid.Column="4" Style="{StaticResource AppToolbarButtonStyle}" Command="{Binding ClearAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonClear}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Шляхи пошуку/збереження + стан пошуку файлів (бейджі Found/NotFound/Ambiguous,
                     повернуті у верхню видиму зону — RF-007/RF-019). -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <controls:LabeledPathPicker Grid.Row="0"
                        Label="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelSearchPath}"
                        ButtonText="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonBrowse}"
                        PathValue="{Binding SearchPath, UpdateSourceTrigger=PropertyChanged}"
                        BrowseCommand="{Binding BrowseSearchPathCommand}" />
                    <controls:LabeledPathPicker Grid.Row="2"
                        Label="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelOutputPath}"
                        ButtonText="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonBrowse}"
                        PathValue="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                        BrowseCommand="{Binding BrowseOutputPathCommand}" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=StatTotal}" />
                        <TextBlock VerticalAlignment="Center" Margin="6,0,16,0" Text="{Binding TotalCount}" />

                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=StatFound}" />
                        <Border VerticalAlignment="Center" Margin="6,0,16,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource FoundRowBrush}">
                            <TextBlock Text="{Binding FoundCount}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=StatNotFound}" />
                        <Border VerticalAlignment="Center" Margin="6,0,16,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource NotFoundRowBrush}">
                            <TextBlock Text="{Binding NotFoundCount}" FontWeight="SemiBold" />
                        </Border>

                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=StatAmbiguous}" />
                        <Border VerticalAlignment="Center" Margin="6,0,0,0" Padding="8,2" CornerRadius="10" Background="{DynamicResource AmbiguousRowBrush}">
                            <TextBlock Text="{Binding AmbiguousCount}" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок секции — визуальное зонирование окна (docs/UX_Audit.md, "Список изменений → Important"). -->
                <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=SectionMaterials}" />

                <!-- Чипы материалов проекта — клик делает материал "активным" для следующей вставки -->
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding Materials}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialChipStyle}" Padding="8,3" Width="Auto" Height="Auto">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=TooltipRemoveMaterial}"
                                                Command="{Binding DataContext.DeleteMaterialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                Padding="0" Width="18" Height="18" Background="Transparent" BorderThickness="0"
                                                VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
                                        </Button>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <materialDesign:PopupBox ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=TooltipAddMaterial}" Margin="0,0,6,0" StaysOpen="False">
                        <materialDesign:PopupBox.ToggleContent>
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                        </materialDesign:PopupBox.ToggleContent>
                        <ItemsControl ItemsSource="{Binding AvailableLibraryMaterials}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Style="{StaticResource AppButtonStyle}"
                                            Width="Auto" Height="Auto" Padding="6,2" HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.AddMaterialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </materialDesign:PopupBox>
                </StackPanel>

                <ToolBarTray Grid.Row="4" Margin="0,0,0,6">
                    <ToolBar>
                        <Button Style="{StaticResource AppIconButtonStyle}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonUndo}" Command="{Binding UndoCommand}">
                            <materialDesign:PackIcon Kind="UndoVariant" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource AppIconButtonStyle}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonAddRow}" Command="{Binding AddRowCommand}">
                            <materialDesign:PackIcon Kind="PlusBoxOutline" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource AppIconButtonStyle}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonDeleteRow}" Command="{Binding DeleteSelectedRowsCommand}">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" />
                        </Button>
                        <Button Style="{StaticResource AppIconButtonStyle}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonSelectFileManually}" Command="{Binding SelectFileManuallyCommand}" CommandParameter="{Binding SelectedRow}">
                            <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="16" Height="16" />
                        </Button>
                    </ToolBar>
                </ToolBarTray>

                <!-- EnableRowVirtualization специально выключен (RF-006 был откачен после визуальной
                     проверки: включение виртуализации вместе с GroupStyle ломало раскладку колонок
                     таблицы — колонки/заголовки переставали корректно отрисовываться). Это тот самый
                     риск, который был явно отмечен в docs/Implementation_Log.md как требующий ручной
                     проверки — проверка не прошла, изменение отменено. -->
                <DataGrid Grid.Row="5" x:Name="PartsGrid"
                          ItemsSource="{Binding RowsView}" SelectedItem="{Binding SelectedRow}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserResizeColumns="True" CanUserReorderColumns="False" CanUserSortColumns="False"
                          EnableRowVirtualization="False" EnableColumnVirtualization="False"
                          RowHeight="28" ColumnHeaderHeight="30"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                          VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                          AllowDrop="True"
                          PreviewKeyDown="PartsGrid_PreviewKeyDown"
                          Drop="PartsGrid_Drop"
                          RowStyle="{StaticResource PartRowStyle}">
                    <!-- DataGridColumnHeader/DataGridCell по умолчанию задают Foreground через SystemColors
                         (не наследуется от TextElement.Foreground окна) — без явного стиля заголовки/ячейки
                         оставались нечитаемыми в тёмной теме. -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="4,4" />
                            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.GroupStyle>
                        <GroupStyle HeaderTemplate="{StaticResource SectionGroupHeaderTemplate}" />
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="ColSeq" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnSeq}" Binding="{Binding RowNumberInSection}" Width="35" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- DataGridCheckBoxColumn заменён на DataGridTemplateColumn с явным CheckBox:
                             штатная колонка-чекбокс в WPF показывает в режиме отображения (до входа
                             в режим редактирования) визуально почти невидимый "выключенный" чекбокс —
                             известная особенность связки WPF DataGrid + MaterialDesign (низкая
                             контрастность/эффект "disabled" стиля отображения). Явный CheckBox в
                             шаблоне всегда рендерится полностью и реагирует на клик сразу, без
                             промежуточного клика для входа в редактирование. -->
                        <DataGridTemplateColumn x:Name="ColEnabled" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnEnabled}" Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource AppCheckBoxStyle}" IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColNumber" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnNumber}" Binding="{Binding Number}" Width="90" />
                        <DataGridTextColumn x:Name="ColTitle" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnTitle}" Binding="{Binding Title}" Width="140" />
                        <DataGridTemplateColumn x:Name="ColQty" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnQty}" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="24" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="-" Padding="0" Margin="0,1"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                        <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center" VerticalContentAlignment="Center"
                                                 BorderThickness="0" Background="Transparent" Margin="0" Padding="0" />
                                        <Button Grid.Column="2" Content="+" Padding="0" Margin="0,1"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColDxf" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnDxfFile}" Binding="{Binding DxfPath}" Width="280" IsReadOnly="True" />
                        <DataGridTemplateColumn x:Name="ColDimensions" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnDimensions}" Width="70" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="2" CornerRadius="2" BorderThickness="1" Background="Transparent">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOversized}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource OversizedBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Dimensions}" TextAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColMaterial" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnMaterial}" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Materials, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValue="{Binding MaterialId, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              IsReadOnly="False"
                                              Style="{StaticResource AppMaterialComboBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridComboBoxColumn x:Name="ColGrain" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnGrain}"
                                                SelectedValueBinding="{Binding GrainMode}"
                                                SelectedValuePath="Value"
                                                ItemsSource="{StaticResource GrainModes}"
                                                DisplayMemberPath="DisplayName"
                                                Width="100" />
                        <DataGridTemplateColumn x:Name="ColRotate" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnRotate}" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource AppCheckBoxStyle}" IsChecked="{Binding CanRotate, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColStatus" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnStatus}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Status}" HorizontalContentAlignment="Left"
                                                Background="{DynamicResource AppTransparentBackgroundBrush}" BorderThickness="0" Padding="4,0"
                                                Command="{Binding DataContext.ResolveStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=TooltipResolveDxf}" />
                                        <materialDesign:PackIcon Kind="AlertOutline" Margin="2,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource GeometryWarningBrush}"
                                                                 ToolTip="{Binding GeometryDiagnosticText}"
                                                                 Visibility="{Binding HasGeometryWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <materialDesign:PackIcon Kind="AlertCircleOutline" Margin="2,0" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource GeometryErrorBrush}"
                                                                 ToolTip="{Binding GeometryDiagnosticText}"
                                                                 Visibility="{Binding HasGeometryError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Нижняя дублирующая панель Nest/Export/Open убрана — эти команды живут только в тулбаре
             выше (Row 2 карточки), без повтора (docs/UX_Audit.md, раздел 5.1, v3). -->
        <Border Grid.Row="6" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <!-- Индикатор занятости на время Nest/Export — раньше при длительной операции не было
                     никакой визуальной обратной связи (docs/UX_Audit.md, "Список изменений → Important"). -->
                <ProgressBar Grid.Column="1" Height="16" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
