<Window x:Class="NStCut.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NStCut.App.Services"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MenuAbout}"
        Width="400" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="pack://application:,,,/nstcut_logo.png"
               Height="72" Stretch="Uniform" HorizontalAlignment="Center" />

        <StackPanel Grid.Row="1" Margin="0,8,0,8">
            <TextBlock Text="N.StCut" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock x:Name="VersionText" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutAuthor}"
                       Margin="0,4,0,0" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutContact}"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutDescription}"
                       TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutLicenseLine}"
                       Margin="0,2,0,0" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=AboutThirdPartyHeader}"
                       FontWeight="Bold" Margin="0,12,0,4" />
            <TextBlock>
                <Run Text="netDxf 3.0.1" /><LineBreak />
                <Run Text="DocX / Xceed.Words.NET" /><LineBreak />
                <Run Text="SkiaSharp" /><LineBreak />
                <Run Text="MaterialDesignThemes 4.9.0" /><LineBreak />
                <Run Text="ExcelDataReader 3.7.0" /><LineBreak />
                <Run Text="System.Drawing.Common 8.0.0" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource AppButtonStyle}" MinWidth="90"
                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonLicense}"
                    Click="License_Click" Margin="0,0,12,0" />
            <Button Style="{StaticResource AppButtonStyle}" MinWidth="90"
                    Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOk}"
                    IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
