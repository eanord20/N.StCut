<Window x:Class="NStCut.App.Views.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NStCut.Core.Models;assembly=NStCut.Core"
        xmlns:loc="clr-namespace:NStCut.App.Services"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=MaterialsWindowTitle}" Height="850" Width="1250"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <!-- Implicit-стили (без x:Key) — DataGridColumnHeader/DataGridCell по умолчанию задают Foreground
             через SystemColors, не наследуя TextElement.Foreground окна; без этого заголовки/ячейки
             оставались бы нечитаемыми в тёмной теме (тот же фикс, что и для главной таблицы). -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="4,4" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="CenteredCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelLibrary}" FontWeight="Bold" />
        <DataGrid Grid.Row="2" x:Name="LibraryGrid"
                  ItemsSource="{Binding LibraryMaterials}" SelectedItem="{Binding SelectedLibraryMaterial}"
                  AutoGenerateColumns="False" CanUserAddRows="False" FontSize="14"
                  BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1"
                  GridLinesVisibility="All"
                  HorizontalGridLinesBrush="{DynamicResource MaterialDesignDivider}"
                  VerticalGridLinesBrush="{DynamicResource MaterialDesignDivider}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColName" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnName}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn x:Name="ColLength" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnLength}" Binding="{Binding Length}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}" />
                <DataGridTextColumn x:Name="ColWidth" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnWidth}" Binding="{Binding Width}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}" />
                <DataGridTextColumn x:Name="ColThickness" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnThickness}" Binding="{Binding Thickness}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}" />
                <DataGridTextColumn x:Name="ColMaterialMargin" Binding="{Binding SheetMarginMm, TargetNullValue=''}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}">
                    <DataGridTextColumn.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnMaterialMargin}" />
                            <TextBlock Text="?" Cursor="Help" FontWeight="Bold" Margin="4,0,0,0" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=HintMaterialMargin}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColMaterialGap" Binding="{Binding PartGapMm, TargetNullValue=''}" Width="105" ElementStyle="{StaticResource CenteredCellStyle}">
                    <DataGridTextColumn.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnMaterialGap}" />
                            <TextBlock Text="?" Cursor="Help" FontWeight="Bold" Margin="4,0,0,0" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=HintMaterialGap}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTemplateColumn x:Name="ColHasGrain" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnHasGrain}" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource AppCheckBoxStyle}" IsChecked="{Binding HasGrain, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridComboBoxColumn x:Name="ColGrain" Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnGrain}" SelectedItemBinding="{Binding GrainDirection}" ItemsSource="{x:Static local:GrainDirectionValues.Values}" Width="105" />
                <!-- Трёхсостоянный чекбокс: пусто = глобальная настройка мягкого отступа. -->
                <DataGridTemplateColumn x:Name="ColMarginRelax" Width="105">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnMarginRelax}" />
                            <TextBlock Text="?" Cursor="Help" FontWeight="Bold" Margin="4,0,0,0" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                                <TextBlock.ToolTip>
                                    <ToolTip MaxWidth="320">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=HintMaterialMarginRelax}" TextWrapping="Wrap" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource AppCheckBoxStyle}" IsThreeState="True" IsChecked="{Binding AllowMarginRelax, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonAdd}" Command="{Binding AddToLibraryCommand}" />
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonDelete}" Command="{Binding DeleteFromLibraryCommand}" />
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonCopyMaterial}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=TooltipCopyMaterial}" Command="{Binding CopyCommand}" />
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonImport}" Click="Import_Click" />
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonExport}" Click="Export_Click" />
            <TextBlock x:Name="TransferStatus" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOk}" Command="{Binding OkCommand}" IsDefault="True" Click="Ok_Click" />
            <Button Style="{StaticResource AppButtonStyle}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonCancel}" Command="{Binding CancelCommand}" IsCancel="True" Margin="0" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
