<Window x:Class="NStCut.App.Views.MaterialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NStCut.Core.Models;assembly=NStCut.Core"
        Title="Materials" Height="500" Width="700">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="100" />
                <DataGridTextColumn Header="Width" Binding="{Binding Width}" Width="100" />
                <DataGridTextColumn Header="Thickness" Binding="{Binding Thickness}" Width="100" />
                <DataGridCheckBoxColumn Header="Has grain" Binding="{Binding HasGrain}" />
                <DataGridComboBoxColumn Header="Grain" SelectedItemBinding="{Binding GrainDirection}" ItemsSource="{x:Static local:GrainDirectionValues.Values}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Add" Command="{Binding AddCommand}" Margin="0,0,8,0" />
            <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
            <Button Content="OK" Command="{Binding OkCommand}" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</Window>
