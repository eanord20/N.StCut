<Window x:Class="NStCut.App.Views.SheetPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NStCut.App.Services"
        xmlns:converters="clr-namespace:NStCut.App.Converters"
        xmlns:coreConstants="clr-namespace:NStCut.Core.Constants;assembly=NStCut.Core"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=SheetPreviewTitle}" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <converters:LocalizedFormatMultiValueConverter x:Key="LocalizedFormatConverter" />
        <!-- Темизированный ToolTip — системный нечитаем на тёмной теме -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MaxWidth" Value="420" />
        </Style>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Command="{Binding RenestCurrentSheetCommand}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonRenestCurrentSheet}">
                <materialDesign:PackIcon Kind="Play" Width="24" Height="24" />
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                <Button Command="{Binding ExportDxfCommand}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonExportDxf}" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="FileExport" Width="24" Height="24" />
                </Button>
                <Button Command="{Binding ExportReportCommand}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonExportReport}" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="FileWordBox" Width="24" Height="24" />
                </Button>
                <Button Command="{Binding OpenDxfCommand}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOpenDxfFolder}" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="24" Height="24" />
                </Button>
                <Button Command="{Binding OpenReportCommand}" ToolTip="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonOpenReport}">
                    <materialDesign:PackIcon Kind="FileEyeOutline" Width="24" Height="24" />
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelZoom}" />
                <Slider Value="{Binding Zoom, Mode=TwoWay}" Minimum="0.1" Maximum="2.0" TickFrequency="0.1" MinWidth="120" Width="Auto" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Zoom, StringFormat='{}{0:P0}'}" />
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                                <Binding Path="Index" />
                                <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="SheetPreviewTabFormat" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                                    <Binding Path="Material.Name" />
                                    <Binding Path="Material.Length" />
                                    <Binding Path="Material.Width" />
                                    <Binding Path="UtilizationPercent" />
                                    <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="SheetPreviewFormat" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding Material.Length}" Height="{Binding Material.Width}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}" ScaleY="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid.LayoutTransform>
                                <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="{DynamicResource SheetPreviewBackgroundBrush}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Width="{Binding Width}" Height="{Binding Height}">
                                                <Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="{DynamicResource SheetPreviewPartStrokeBrush}" Fill="{DynamicResource SheetPreviewPartFillBrush}" StrokeThickness="0.5" Cursor="Hand" MouseLeftButtonDown="OnPartMouseLeftButtonDown" MouseMove="OnPartMouseMove" MouseLeftButtonUp="OnPartMouseLeftButtonUp" MouseRightButtonDown="OnPartMouseRightButtonDown" />
                                                <TextBlock Text="{Binding DisplayIndex}" Foreground="Black" IsHitTestVisible="False"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="{Binding DataContext.PartLabelFontSize, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <TextBlock.LayoutTransform>
                                                        <ScaleTransform ScaleX="{Binding DataContext.ZoomInverse, RelativeSource={RelativeSource AncestorType=Window}}" ScaleY="{Binding DataContext.ZoomInverse, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </TextBlock.LayoutTransform>
                                                </TextBlock>
                                                <Path Data="{Binding ContourGeometry}" Stroke="{DynamicResource SheetPreviewPartStrokeBrush}" StrokeThickness="0.2" Fill="Transparent" IsHitTestVisible="False">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasContour}" Value="False">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Canvas IsHitTestVisible="False">
                                    <Path Stroke="Black" StrokeThickness="{x:Static coreConstants:ExportPresentationConstants.GrainArrowLineThickness}" Data="{Binding ArrowGeometry}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasGrain}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding DirectionText}" Canvas.Left="8" Canvas.Top="8" Foreground="Black" Background="White" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Parts}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,4,0,0" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="№" Binding="{Binding DisplayIndex}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnNumber}" Binding="{Binding Source.Source.Number}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnName}" Binding="{Binding Source.Source.DisplayName}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnCopy}" Binding="{Binding Source.CopyIndex}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnRotation}" Binding="{Binding Source.Rotation, StringFormat='{}{0:F1}'}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnX}" Binding="{Binding Source.Position.X, StringFormat='{}{0:F1}'}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnY}" Binding="{Binding Source.Position.Y, StringFormat='{}{0:F1}'}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnW}" Binding="{Binding Source.Bounds.Width, StringFormat='{}{0:F1}'}" />
                                <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ColumnH}" Binding="{Binding Source.Bounds.Height, StringFormat='{}{0:F1}'}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="3" Text="{Binding QualityText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MaterialDesignBody}" FontSize="12" Margin="0,4,0,0" />
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
