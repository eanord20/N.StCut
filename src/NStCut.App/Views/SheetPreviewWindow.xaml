<Window x:Class="NStCut.App.Views.SheetPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NStCut.App.Services"
        xmlns:converters="clr-namespace:NStCut.App.Converters"
        xmlns:coreConstants="clr-namespace:NStCut.Core.Constants;assembly=NStCut.Core"
        Title="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=SheetPreviewTitle}" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowState="Normal"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}">
    <Window.Resources>
        <converters:LocalizedFormatMultiValueConverter x:Key="LocalizedFormatConverter" />
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ToolBarTray Grid.Row="0" IsHitTestVisible="True">
            <ToolBar>
                <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=LabelZoom}" />
                <Slider Value="{Binding Zoom, Mode=TwoWay}" Minimum="0.1" Maximum="2.0" TickFrequency="0.1" Width="120" VerticalAlignment="Center" Margin="6,0" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Zoom, StringFormat='{}{0:P0}'}" />
                <Button Command="{Binding RenestCurrentSheetCommand}" Content="{Binding Source={x:Static loc:LocalizationService.Instance}, Path=ButtonRenestCurrentSheet}" Margin="8,0,0,0" />
            </ToolBar>
        </ToolBarTray>
        <TabControl Grid.Row="1" ItemsSource="{Binding Sheets}" SelectedItem="{Binding SelectedSheet, Mode=TwoWay}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                                <Binding Path="Index" />
                                <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="SheetPreviewTabFormat" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource LocalizedFormatConverter}">
                                    <Binding Path="Material.Name" />
                                    <Binding Path="Material.Length" />
                                    <Binding Path="Material.Width" />
                                    <Binding Path="UtilizationPercent" />
                                    <Binding Source="{x:Static loc:LocalizationService.Instance}" Path="SheetPreviewFormat" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid Width="{Binding Material.Length}" Height="{Binding Material.Width}">
                                <Grid.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}" ScaleY="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid.LayoutTransform>
                                <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Background="{DynamicResource SheetPreviewBackgroundBrush}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="{DynamicResource SheetPreviewPartStrokeBrush}" Fill="{DynamicResource SheetPreviewPartFillBrush}" StrokeThickness="0.5" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Canvas IsHitTestVisible="False">
                                    <Path Stroke="Black" StrokeThickness="{x:Static coreConstants:ExportPresentationConstants.GrainArrowLineThickness}" Data="{Binding ArrowGeometry}">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasGrain}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding DirectionText}" Canvas.Left="8" Canvas.Top="8" Foreground="Black" Background="White" />
                                </Canvas>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
