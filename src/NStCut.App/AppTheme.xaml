<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="NotFoundRowBrush" Color="#F7C7AC" />
    <SolidColorBrush x:Key="ManuallySelectedRowBrush" Color="#FFF7DC" />
    <SolidColorBrush x:Key="AmbiguousRowBrush" Color="#C3E0E5" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5" />
    <Thickness x:Key="CardPadding">8</Thickness>
    <Thickness x:Key="SmallMargin">6</Thickness>
    <sys:Double x:Key="DefaultFontSize">13</sys:Double>
</ResourceDictionary>
