<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="FoundRowBrush" Color="#90EE90" />
    <SolidColorBrush x:Key="NotFoundRowBrush" Color="#F7C7AC" />
    <SolidColorBrush x:Key="ManuallySelectedRowBrush" Color="#FFF7DC" />
    <SolidColorBrush x:Key="AmbiguousRowBrush" Color="#C3E0E5" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="DuplicateNumberBrush" Color="#E53935" />
    <SolidColorBrush x:Key="OversizedBorderBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="ActiveSectionBrush" Color="#BBDEFB" />
    <SolidColorBrush x:Key="GeometryWarningBrush" Color="#F57C00" />
    <SolidColorBrush x:Key="GeometryErrorBrush" Color="#D32F2F" />
    <SolidColorBrush x:Key="AppTransparentBackgroundBrush" Color="Transparent" />
    <Thickness x:Key="CardPadding">8</Thickness>
    <Thickness x:Key="SmallMargin">6</Thickness>
    <sys:Double x:Key="DefaultFontSize">13</sys:Double>
    <sys:Double x:Key="DisabledMenuItemOpacity">0.4</sys:Double>
    <SolidColorBrush x:Key="AppCheckBoxCheckedBrush" Color="#1976D2" />
    <SolidColorBrush x:Key="AppCheckBoxGlyphBrush" Color="White" />
    <SolidColorBrush x:Key="SheetPreviewBackgroundBrush" Color="White" />
    <SolidColorBrush x:Key="SheetPreviewPartStrokeBrush" Color="Blue" />
    <SolidColorBrush x:Key="SheetPreviewPartFillBrush" Color="LightBlue" />

    <!-- Явные контрастные ресурсы для меню и полей ввода (см. Task 4 DXF-mode-dark-theme-fixes).
         Цвета вынесены как Color, чтобы кисти и переопределения шаблонных ключей WPF не дублировали литералы. -->
    <Color x:Key="AppMenuBackgroundColor">#F5F5F5</Color>
    <Color x:Key="AppMenuForegroundColor">#212121</Color>
    <Color x:Key="AppInputBackgroundColor">#FFFFFF</Color>
    <Color x:Key="AppInputForegroundColor">#212121</Color>
    <Color x:Key="AppInputDropDownBackgroundColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="AppMenuBackgroundBrush" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="AppMenuForegroundBrush" Color="{StaticResource AppMenuForegroundColor}" />
    <SolidColorBrush x:Key="AppInputBackgroundBrush" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="AppInputForegroundBrush" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="AppInputDropDownBackgroundBrush" Color="{StaticResource AppInputDropDownBackgroundColor}" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="{StaticResource AppMenuForegroundColor}" />
    <SolidColorBrush x:Key="MaterialDesignTextBoxBackground" Color="{StaticResource AppInputBackgroundColor}" />

    <!-- Переопределения шаблонных ключей WPF Menu/MenuItem — гарантируют, что popup-фон и текст
         используют App-контраст, независимо от того, учитывает ли шаблон MenuItem.Background. -->
    <SolidColorBrush x:Key="SubMenuBackgroundBrush" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="Menu.Static.Foreground" Color="{StaticResource AppMenuForegroundColor}" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Background" Color="{StaticResource AppMenuBackgroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Disabled.Border" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="{StaticResource AppInputForegroundColor}" />

    <!--
        Компактные, явно видимые кнопки — заменяют избыточно "тач-дружелюбные" дефолты MaterialDesignThemes.
        ВАЖНО: это именованный стиль (x:Key), а НЕ implicit-стиль для типа Button. Implicit-стиль применялся
        бы ко ВСЕМ кнопкам в приложении, включая крошечные "-"/"+" и кнопку статуса внутри ячеек DataGrid
        (колонки шириной 24-130px) — там принудительные Padding/MinHeight/Margin ломали раскладку строки
        настолько, что вся строка/заголовки таблицы переставали корректно отрисовываться. Поэтому стиль
        подключается точечно (Style="{StaticResource AppButtonStyle}") только на "обычных" кнопках вне DataGrid. -->
    <Style x:Key="AppButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppToolbarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="30" />
    </Style>

    <Style x:Key="AppIconButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{DynamicResource AppMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMenuForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Background" Value="{DynamicResource AppMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMenuForegroundBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="{DynamicResource DisabledMenuItemOpacity}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{DynamicResource AppMenuBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppMenuForegroundBrush}" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignTextBoxBackground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MaterialDesignBody}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
        <Setter Property="Background" Value="{DynamicResource MaterialDesignTextBoxBackground}" />
    </Style>

    <!-- Выделенный стиль для выпадающего выбора материала в таблице деталей (Task 4).
         Использует явные контрастные ресурсы, чтобы текст не сливался с фоном в тёмной теме. -->
    <Style x:Key="AppMaterialComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppInputForegroundBrush}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="{x:Type ComboBoxItem}">
                    <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AppInputDropDownBackgroundBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Собственный implicit-стиль для DataGrid — переопределяет раскладку MaterialDesign.
        В отличие от Button, DataGrid не вложен внутрь себя, поэтому implicit-стиль здесь
        безопасен и не ломает внутренние кнопки/ячейки. Шаблон MaterialDesign сохраняется
        через BasedOn, а Margin/Padding/BorderThickness принудительно обнуляются, чтобы
        таблица растягивалась на доступную ширину без лишних отступов от темы.
    -->
    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="AppCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <BulletDecorator>
                        <BulletDecorator.Bullet>
                            <Grid Width="20" Height="20">
                                <Border x:Name="CheckBorder" Width="20" Height="20" Background="Transparent" BorderBrush="{DynamicResource MaterialDesignBody}" BorderThickness="1.5" CornerRadius="2" />
                                <Path x:Name="CheckMark" Data="M 2 10 L 7 15 L 16 4" Stroke="{DynamicResource AppCheckBoxGlyphBrush}" StrokeThickness="2" Stretch="Uniform" Margin="2" Visibility="Collapsed" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AppCheckBoxCheckedBrush}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AppCheckBoxCheckedBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckBorder" Property="Opacity" Value="0.4" />
                            <Setter TargetName="CheckMark" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Чекбокс с видимой подписью (AppCheckBoxStyle обрезает контент фиксированными 20x20) -->
    <Style x:Key="AppCheckBoxLabeledStyle" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource AppCheckBoxStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
</ResourceDictionary>
