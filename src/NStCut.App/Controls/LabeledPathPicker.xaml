<!-- Повторяющийся блок "лейбл — поле пути — кнопка Огляд" (был продублирован дважды в MainWindow.xaml
     для путей поиска/сохранения) — вынесен в переиспользуемый UserControl (RF-025,
     docs/Code_Audit_UI.md, "Important Improvements → Читаемость XAML"). -->
<UserControl x:Class="NStCut.App.Controls.LabeledPathPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Label, ElementName=Root}" />
        <TextBox Grid.Column="2" Text="{Binding PathValue, ElementName=Root, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
        <Button Grid.Column="4" Style="{StaticResource AppIconButtonStyle}"
                ToolTip="{Binding ButtonText, ElementName=Root}"
                Command="{Binding BrowseCommand, ElementName=Root}">
            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="16" Height="16" />
        </Button>
    </Grid>
</UserControl>
